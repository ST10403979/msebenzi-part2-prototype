<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Msebenzi" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/msebenzi_green</item>
        <item name="colorPrimaryVariant">@color/msebenzi_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/msebenzi_accent</item>
        <item name="colorOnSecondary">@color/msebenzi_text_primary</item>
        <item name="android:statusBarColor">@color/msebenzi_green_dark</item>
        <item name="android:windowBackground">@color/msebenzi_neutral_bg</item>
        <item name="android:textColorPrimary">@color/msebenzi_text_primary</item>
        <item name="android:textColorSecondary">@color/msebenzi_text_secondary</item>
        <item name="materialCardViewStyle">@style/Widget.Msebenzi.CardView</item>
        <item name="textInputStyle">@style/Widget.Msebenzi.TextInputLayout</item>
    </style>

    <style name="Widget.Msebenzi" parent="" />

    <!-- Slightly more rounded, gently elevated cards throughout the app -->
    <style name="Widget.Msebenzi.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Rounded, outlined text fields used across every form in the app -->
    <style name="Widget.Msebenzi.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/msebenzi_green</item>
    </style>

    <!-- Small rounded pill used for job status / verification badges -->
    <style name="Widget.Msebenzi.StatusChip" parent="">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
    </style>
</resources>
