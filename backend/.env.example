# Copy this file to .env and fill in your own values.
# Never commit your real .env file to GitHub.

# Server
PORT=3000

# Auth
JWT_SECRET=replace_with_a_long_random_string

# Admin (used only by PUT /api/admin/users/:id/verify to approve a
# worker's verification request — see README section 1.1)
ADMIN_TOKEN=replace_with_a_long_random_string

# Database
# Leave DATABASE_URL blank to use a local SQLite file for development.
# When you host on Render, Render will give you a Postgres connection
# string to paste here, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=
